# Copie para .env e preencha. O arquivo .env NUNCA vai para o git.
# Gerar senha do banco: openssl rand -hex 24
POSTGRES_DB=julia
POSTGRES_USER=julia
POSTGRES_PASSWORD=troque-esta-senha

# Endereço público (sem https://). O Caddy emite o certificado sozinho quando o DNS aponta para a máquina.
DOMINIO=julia.exemplo.com.br

# Porta local do app (127.0.0.1). Usada quando já existe um proxy na máquina; com o Caddy do compose não é necessária.
APP_PORTA=8095

# Limites de recursos (ajuste ao mudar de máquina)
LIMITE_APP=256m
LIMITE_BANCO=384m
