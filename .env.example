# Copie para .env e preencha. O arquivo .env NUNCA vai para o git.
# Gerar senha do banco: openssl rand -hex 24
POSTGRES_DB=julia
POSTGRES_USER=julia
POSTGRES_PASSWORD=troque-esta-senha

# Endereço público (sem https://). O Caddy emite o certificado sozinho quando o DNS aponta para a máquina.
DOMINIO=julia.exemplo.com.br

# Porta local do app (127.0.0.1). Usada quando já existe um proxy na máquina; com o Caddy do compose não é necessária.
APP_PORTA=8095

# Limites de recursos (ajuste ao mudar de máquina)
LIMITE_APP=256m
LIMITE_BANCO=384m

# WhatsApp pela uazapi. DEIXE VAZIO até a RS Tech liberar: sem isto nenhuma mensagem sai para clientes.
# Webhook da instância: https://DOMINIO/api/uazapi/webhook/<UAZAPI_WEBHOOK_SECRET>   (segredo: openssl rand -hex 24)
UAZAPI_URL=
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_SECRET=
WHATSAPP_LIBERADO=nao

# Nota fiscal (NF-e) pelo Focus NFe. DEIXE VAZIO até ter certificado digital, provedor contratado e ordem expressa.
FOCUS_TOKEN=
NF_EMISSAO_LIBERADA=nao

# IA de atendimento (Claude). DEIXE VAZIO até a RS Tech fornecer a chave da Júlia.
ANTHROPIC_API_KEY=

# Rastreio de entrega (mapa, rota, endereço). DEIXE VAZIO para usar os serviços gratuitos do OpenStreetMap (custo zero).
# Só preencha se o volume crescer e for trocar de provedor (ex.: TILES_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=SUA_CHAVE).
TILES_URL=
TILES_ATRIBUICAO=
OSRM_URL=
NOMINATIM_URL=
