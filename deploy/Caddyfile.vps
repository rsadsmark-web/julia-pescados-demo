# Júlia Pescados — bloco do Caddy da máquina (trocar o domínio ao apontar o DNS; pronto para ficar atrás da Cloudflare).
#
# Quem responde o quê:
#   Caddy (do disco, sem Node, sem banco): loja, receitas, css/js/imagens e /estado-publico.json (catálogo)
#   Node + Postgres: /api/* (pedido, lista de espera, login, painel), /saude e as páginas do painel (login obrigatório)
#
# Atrás da Cloudflare: proxy laranja ligado, SSL "Full (strict)", e "Cache Everything" não é necessário (os cabeçalhos
# Cache-Control abaixo já dizem o que pode ser guardado). /api/* e o painel nunca são guardados (Cache-Control: no-store).
# Opções globais (uma vez no topo do Caddyfile da máquina) para enxergar o IP real do visitante pela Cloudflare:
#   {
#       servers {
#           trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
#           client_ip_headers CF-Connecting-IP
#       }
#   }
# (lista oficial: https://www.cloudflare.com/ips/ — conferir de tempos em tempos)

(servir) {
	file_server {
		precompressed br gzip
	}
}

(servir) {
	file_server {
		precompressed br gzip
	}
}

julia.rstechmarketing.com.br, julia.157-173-206-42.sslip.io {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# endereços limpos: o antigo com .html (e /index) redireciona com 301 para o limpo, mantendo a consulta (?x=1)
	map {query} {qs} {
		~.+ "?{query}"
		default ""
	}
	@indice path /index.html /index
	redir @indice /{qs} 301
	@antiga path_regexp antiga ^/(.+)\.html$
	redir @antiga /{re.antiga.1}{qs} 301

	root * /opt/julia-pescados/publico

	# catálogo público: arquivo escrito pelo Node quando o painel salva; curto para o estoque não ficar velho
	handle /estado-publico.json {
		root * /opt/julia-pescados/dinamico
		header Cache-Control "public, max-age=15, s-maxage=30, stale-while-revalidate=120, stale-if-error=3600"
		file_server
	}

	# API, saúde e script de configuração do painel: Node (a API se protege com limite de requisições por IP)
	handle /api/* {
		reverse_proxy 127.0.0.1:8095 {
			header_up X-Cliente-IP {client_ip}
		}
	}
	handle /saude {
		reverse_proxy 127.0.0.1:8095
	}

	handle {
		# arquivo existe na pasta pública? serve do disco (já comprimido .br/.gz); senão é página do painel: Node, com login
		@estatico file {
			try_files {path} {path}.html {path}/index.html
		}
		handle @estatico {
			# cada classe de arquivo tem o seu cache (handles não se somam: vale o primeiro que casar)
			@versionado query v=*
			handle @versionado {
				header Cache-Control "public, max-age=31536000, immutable"
				import servir
			}
			@imagens path /img/*
			handle @imagens {
				header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
				import servir
			}
			@paginas path / /receitas /login /manifest.webmanifest
			handle @paginas {
				header Cache-Control "public, max-age=60, s-maxage=300, stale-while-revalidate=600, stale-if-error=86400"
				import servir
			}
			handle {
				header Cache-Control "public, max-age=3600"
				import servir
			}
		}
		handle {
			reverse_proxy 127.0.0.1:8095 {
				header_up X-Cliente-IP {client_ip}
			}
		}
	}
}
