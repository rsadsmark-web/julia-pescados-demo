# Júlia Pescados — Caddyfile para o DOMÍNIO DEFINITIVO atrás da Cloudflare. MODELO: nada aqui está instalado.
# Trocar NOVO_DOMINIO (ex.: juliapescados.com.br) e seguir docs/DOMINIO-CLOUDFLARE.md. Validar com `caddy validate` antes do reload.

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# o endereço de hoje continua vivo por 30 dias e manda todo mundo para o novo (301), mantendo o caminho e a consulta
julia.rstechmarketing.com.br {
	redir https://NOVO_DOMINIO{uri} 301
}

# www vai para a raiz
www.NOVO_DOMINIO {
	redir https://NOVO_DOMINIO{uri} 301
}

# o bloco abaixo é o mesmo de deploy/Caddyfile.vps, só com o domínio trocado na primeira linha
NOVO_DOMINIO {
